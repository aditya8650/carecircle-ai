# CareCircle AI Environment Configuration

# Database Connection:
# Default: Local SQLite database for immediate zero-config development.
DATABASE_URL="file:./dev.db"

# Cloud Run / Production (PostgreSQL):
# When deploying to Google Cloud Run, update prisma/schema.prisma to provider = "postgresql"
# and provide your PostgreSQL connection string here:
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/carecircle?sslmode=require"

# JWT Secret for Session Authentication (Change this to a strong secret in production):
SESSION_SECRET="carecircle-super-secret-jwt-key-hackathon-2026"

# Port (Cloud Run injects PORT automatically):
PORT=3000

# Optional Email Dispatch Configuration (Resend or SMTP):
# If RESEND_API_KEY is not set, email reminders run in verified Mock/Simulation mode,
# printing full formatted alerts to server logs and displaying preview in UI.
# RESEND_API_KEY="re_1234567890abcdef"
# EMAIL_FROM="CareCircle AI <notifications@carecircle.ai>"
